generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique // Subdomene eller custom domene, f.eks "acme.lms.no"
  
  // ── Plan & Feature Flags ─────────────────────────────
  plan          TenantPlan @default(FREE)
  addons        String[]   // Feature-flagg: ["brand-detector", "scorm", "custom-domain", ...]
  trialEndsAt   DateTime?  // Utløpsdato for prøveperiode (null = ingen trial)
  auditRetentionDays Int?  // Oppbevaringsdager for audit-logg (null = behold for alltid)
  
  // ── Whitelabel Branding ──────────────────────────────
  // Bakgrunner
  colorBgPrimary    String?  // Hovedbakgrunn (default: #050505)
  colorBgSecondary  String?  // Sekundær bakgrunn / kort (default: #0f0f11)
  
  // Tekst
  colorTextPrimary   String?  // Hovedtekst (default: #ffffff)
  colorTextSecondary String?  // Sekundær tekst / labels (default: #9ca3af)
  
  // Ramme / border
  colorBorder        String?  // Kanter og skillelinjer (default: rgba via hex #1a1a2e)
  
  // Accent / merkevarefarge
  colorAccent        String?  // Aksentfarge – lenker, knapper, fokus (default: #3b82f6)
  
  // Knapper
  colorButtonPrimary String?  // Primærknapp bakgrunn (default: #3b82f6)
  colorButtonText    String?  // Primærknapp tekst (default: #ffffff)
  
  // Sidebar / navigasjon
  colorSidebarBg     String?  // Sidebar bakgrunn (default: #0a0a0a)
  colorSidebarText   String?  // Sidebar tekst (default: #a1a1aa)
  colorSidebarActive String?  // Sidebar aktiv lenke (default: #3b82f6)
  
  // Suksess / advarsel / feil
  colorSuccess       String?  // Suksessfarge (default: #22c55e)
  colorWarning       String?  // Advarselsfarge (default: #f59e0b)
  colorDanger        String?  // Feilfarge (default: #ef4444)

  // ── Tilstander / avledede overstyringer (valgfritt — auto-avledes hvis tom) ──
  colorSidebarHoverBg   String?  // Sidebar hover-bakgrunn (default: avledet overlay)
  colorSidebarHoverText String?  // Sidebar hover-tekst (default: hovedtekst)
  colorTopbarBg         String?  // Topbar-bakgrunn (default: avledet fra hovedbakgrunn)
  colorTopbarText       String?  // Topbar-tekst (default: hovedtekst)

  // Logo
  logoUrl            String?  // URL til logo (PNG/SVG) eller data-URI
  logoSvgContent     String?  @db.Text // Original SVG-innhold for fargeredigering
  logoSvgModified    String?  @db.Text // SVG med endrede farger
  faviconUrl         String?  // URL til favicon
  faviconSvgContent  String?  @db.Text // Original SVG for favicon fargeredigering
  faviconSvgModified String?  @db.Text // Favicon SVG med endrede farger
  
  // Typografi
  fontFamily         String?  // Font for brodtekst (body)
  fontHeading        String?  // Font for overskrifter (headings)
  fontSource         String?  // 'google' | 'custom'
  customFontUrl      String?  // URL til opplastet fontfil
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasjoner
  users     User[]
  groups    Group[]
}

enum GlobalRole {
  USER
  TENANT_ADMIN
  SYSTEM_ADMIN
}

enum TenantPlan {
  FREE       // Gratis prøveperiode / demo
  STANDARD   // Kjerne-LMS
  PLUS       // Avansert branding, SCORM, analytics
  ENTERPRISE // SSO, SCIM, gamification, wiki, LTI
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  firstName     String?
  lastName      String?
  avatarUrl     String?  @db.Text
  
  // Ansatt-profil
  jobTitle      String?   // Stillingstittel
  department    String?   // Avdeling
  bio           String?   @db.Text // Biografi / om meg
  phone         String?   // Telefonnummer
  location      String?   // Arbeidssted / kontor
  workSchedule  String?   // Arbeidstider (f.eks. "08:00–16:00")
  startDate     DateTime? // Startdato i organisasjonen
  
  // SCIM støtte attributter
  externalId    String?  // ID fra kundens IdP
  active        Boolean   @default(true)
  anonymizedAt  DateTime? // Satt når brukeren er GDPR-anonymisert

  // To-faktor (TOTP)
  totpSecret         String?   // Base32 TOTP-hemmelighet (satt under oppsett)
  totpEnabled        Boolean   @default(false)
  totpRecoveryCodes  String[]  // sha256-hashede engangs-gjenopprettingskoder
  
  globalRole    GlobalRole @default(USER)
  
  tenantId      String?
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Leder (for eskalering av frister)
  managerId     String?
  manager       User?      @relation("UserManager", fields: [managerId], references: [id])
  reports       User[]     @relation("UserManager")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  groupMemberships GroupMembership[]
  courseEnrollments CourseEnrollment[]
  certificates     Certificate[]
  notifications    Notification[]
  sessionsTaught     TrainingSession[]   @relation("SessionInstructor")
  sessionEnrollments SessionEnrollment[] @relation("SessionAttendee")
  onboardingEnrollments OnboardingEnrollment[]
  skills             UserSkill[]

  @@index([tenantId])
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?  // Hex farge for gruppen (f.eks. "#3b82f6")
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  externalId  String?  // SCIM gruppe ID

  // Dynamiske grupper: medlemskap utledes fra regler mot brukerattributter
  isDynamic   Boolean  @default(false)
  ruleJson    Json?    // { match: "all"|"any", conditions: [{ attribute, operator, value }] }

  members     GroupMembership[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model GroupMembership {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  source    String   @default("manual") // "manual" | "rule" (dynamisk gruppe) | "scim"

  createdAt DateTime @default(now())

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

// ══════════════════════════════════════════════════════════════
// KURS & LÆRINGSADMINISTRASJON
// ══════════════════════════════════════════════════════════════

enum CourseVisibility {
  DRAFT_ONLY  // Kun synlig for admin
  INTERNAL    // Synlig for innloggede brukere i tenanten
  PUBLIC      // Synlig for alle (SEO-indekserbar)
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseVersionState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  STANDARD
  QUIZ
  DOCUMENT
  VIDEO
  EMBED
  SCORM_PACKAGE
}

enum CompletionRule {
  MANUAL_MARK   // Brukeren markerer selv som fullført
  VIEWED        // Automatisk ved visning
  ALL_BLOCKS    // Alle blokker i leksjonen må fullføres
  QUIZ_PASS     // Bestått quiz kreves
}

enum BlockType {
  TEXT
  IMAGE
  VIDEO
  QUIZ
  DOCUMENT
  EMBED
  AUDIO
  CODE
  CALLOUT
  CHECKLIST
  OPEN_RESPONSE
  DIVIDER
}

enum GatingPolicy {
  NONE              // Ingen begrensning
  LESSON_COMPLETION // Alle leksjoner må fullføres sekvensielt
  QUIZ_SCORE        // Minimum quiz-poengsum kreves
  MANUAL            // Administrator markerer manuelt
}

// ── Kurskategorier ──────────────────────────────────────

model CourseCategory {
  id                String   @id @default(uuid())
  tenantId          String
  slug              String   // URL-vennlig identifikator
  name              String
  description       String?
  parentCategoryId  String?
  parentCategory    CourseCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories   CourseCategory[] @relation("CategoryHierarchy")
  sortOrder         Int      @default(0)
  
  courses           CourseCategoryLink[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([tenantId, slug])
  @@index([tenantId])
}

// ── Tags ────────────────────────────────────────────────

enum TagType {
  TOPIC
  AUDIENCE
  SKILL
  COMPLIANCE
  CUSTOM
}

model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  slug      String
  label     String
  tagType   TagType  @default(CUSTOM)
  
  courses   CourseTagLink[]
  
  createdAt DateTime @default(now())
  
  @@unique([tenantId, slug])
  @@index([tenantId, tagType])
}

// ── Kurs (stabil identitet + katalogmetadata) ───────────

model Course {
  id                        String           @id @default(uuid())
  tenantId                  String
  slug                      String
  title                     String
  description               String?          @db.Text
  visibility                CourseVisibility  @default(DRAFT_ONLY)
  status                    CourseStatus      @default(ACTIVE)
  thumbnailUrl              String?
  estimatedMinutes          Int?
  difficulty                CourseDifficulty?
  defaultLocale             String           @default("nb-NO")
  
  currentPublishedVersionId String?          @unique
  currentPublishedVersion   CourseVersion?   @relation("CurrentPublished", fields: [currentPublishedVersionId], references: [id])
  
  isSystemTemplate          Boolean          @default(false)  // Systemkurs – ikke redigerbart av tenant
  
  versions                  CourseVersion[]  @relation("CourseVersions")
  categories                CourseCategoryLink[]
  tags                      CourseTagLink[]
  assignmentRules           CourseAssignmentRule[]
  enrollments               CourseEnrollment[]
  certificates              Certificate[]
  sessions                  TrainingSession[]
  skills                    CourseSkill[]

  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  
  @@unique([tenantId, slug])
  @@index([tenantId, status, visibility])
}

// ── Kursversjon (immutable published snapshots) ─────────

model CourseVersion {
  id              String             @id @default(uuid())
  courseId         String
  course          Course             @relation("CourseVersions", fields: [courseId], references: [id], onDelete: Cascade)
  versionNumber   Int
  state           CourseVersionState  @default(DRAFT)
  changeLog       String?            @db.Text
  createdByUserId String?
  
  modules         Module[]
  
  currentForCourse Course?           @relation("CurrentPublished")
  enrollments      CourseEnrollment[]
  
  createdAt       DateTime           @default(now())
  publishedAt     DateTime?
  
  @@unique([courseId, versionNumber])
  @@index([courseId, state])
}

// ── Moduler (gruppering av leksjoner) ───────────────────

model Module {
  id              String        @id @default(uuid())
  courseVersionId  String
  courseVersion   CourseVersion  @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  position        Int
  title           String
  summary         String?
  gatingPolicy    GatingPolicy  @default(NONE)
  minQuizScore    Int?          // Minimum poengsum ved QUIZ_SCORE gating
  
  lessons         Lesson[]
  moduleProgress  ModuleProgress[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([courseVersionId, position])
}

// ── Leksjoner (enkeltenhet med innhold) ─────────────────

model Lesson {
  id              String         @id @default(uuid())
  moduleId        String
  module          Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  position        Int
  title           String
  lessonType      LessonType     @default(STANDARD)
  completionRule  CompletionRule @default(MANUAL_MARK)
  estimatedMinutes Int?
  isOptional      Boolean        @default(false)
  
  blocks          LessonBlock[]
  lessonProgress  LessonProgress[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@index([moduleId, position])
}

// ── Innholdsblokker (typed content blocks) ──────────────

model LessonBlock {
  id                String    @id @default(uuid())
  lessonId          String
  lesson            Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position          Int
  type              BlockType
  data              Json      // Typet av block type (TEXT: {format, doc}, IMAGE: {url, alt}, etc.)
  accessibilityMeta Json?     // {alt, captions, transcript}
  
  blockResponses    BlockResponse[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([lessonId, position])
}

// ── Koblingstabeller (Many-to-Many) ─────────────────────

model CourseCategoryLink {
  courseId    String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  categoryId String
  category   CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([courseId, categoryId])
}

model CourseTagLink {
  courseId String
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([courseId, tagId])
}

// ── Kurstildeling & Innmelding ──────────────────────────

enum AssignmentScope {
  USER
  GROUP
  ROLE
  ALL_USERS
}

enum AssignmentState {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  EXEMPT
}

model CourseAssignmentRule {
  id                 String          @id @default(uuid())
  tenantId           String
  courseId            String
  course             Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scopeType          AssignmentScope
  scopeRefId         String?         // userId, groupId, eller rolle-streng avhengig av scopeType
  assignedByUserId   String?
  dueAt              DateTime?
  isMandatory        Boolean         @default(false)
  recertIntervalDays Int?            // Intervall for resertifisering
  notificationPolicy Json?           // {remindersDaysBefore: [14, 7, 1]}
  state              AssignmentState @default(ACTIVE)
  
  enrollments        CourseEnrollment[]
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  @@index([tenantId, courseId])
}

model CourseEnrollment {
  id                     String           @id @default(uuid())
  tenantId               String
  courseId                String
  course                 Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRuleId           String?
  sourceRule             CourseAssignmentRule? @relation(fields: [sourceRuleId], references: [id])
  currentCourseVersionId String?
  currentCourseVersion   CourseVersion?   @relation(fields: [currentCourseVersionId], references: [id])
  status                 EnrollmentStatus @default(NOT_STARTED)
  completionPercentCached Int             @default(0)
  enrolledAt             DateTime         @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  dueAt                  DateTime?
  resumeLessonId         String?
  lastActivityAt         DateTime?
  
  lessonProgress         LessonProgress[]
  moduleProgress         ModuleProgress[]
  progressEvents         ProgressEvent[]
  blockResponses         BlockResponse[]
  certificates           Certificate[]
  
  @@unique([tenantId, courseId, userId, currentCourseVersionId])
  @@index([tenantId, userId])
  @@index([tenantId, courseId])
}

// ── Progresjonssporing ──────────────────────────────────

enum ProgressStatus {
  LOCKED
  AVAILABLE
  STARTED
  COMPLETED
}

model LessonProgress {
  id                String         @id @default(uuid())
  tenantId          String
  courseEnrollmentId String
  courseEnrollment  CourseEnrollment @relation(fields: [courseEnrollmentId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            Lesson         @relation(fields: [lessonId], references: [id])
  status            ProgressStatus @default(AVAILABLE)
  timeSpentSeconds  Int            @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  
  @@unique([courseEnrollmentId, lessonId])
  @@index([tenantId])
}

model ModuleProgress {
  id                String         @id @default(uuid())
  tenantId          String
  courseEnrollmentId String
  courseEnrollment  CourseEnrollment @relation(fields: [courseEnrollmentId], references: [id], onDelete: Cascade)
  moduleId          String
  module            Module         @relation(fields: [moduleId], references: [id])
  status            ProgressStatus @default(AVAILABLE)
  completionPercent Int            @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  
  @@unique([courseEnrollmentId, moduleId])
  @@index([tenantId])
}

model ProgressEvent {
  id                String          @id @default(uuid())
  tenantId          String
  courseEnrollmentId String
  courseEnrollment  CourseEnrollment @relation(fields: [courseEnrollmentId], references: [id], onDelete: Cascade)
  eventType         String          // LESSON_VIEWED, BLOCK_COMPLETED, QUIZ_PASSED, COURSE_COMPLETED, etc.
  entityType        String?         // lesson, module, block, course
  entityId          String?
  payload           Json?
  
  createdAt         DateTime        @default(now())
  
  @@index([tenantId, courseEnrollmentId])
  @@index([tenantId, eventType])
}

// ── Blokk-svar (quiz, refleksjon, sjekkliste) ──────────

model BlockResponse {
  id                 String           @id @default(uuid())
  tenantId           String
  courseEnrollmentId  String
  courseEnrollment    CourseEnrollment @relation(fields: [courseEnrollmentId], references: [id], onDelete: Cascade)
  blockId            String
  block              LessonBlock      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  responseData       Json             // Quiz: { selectedIndices, submittedSteps, completed }  OpenResponse: { text }
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  @@unique([courseEnrollmentId, blockId])
  @@index([courseEnrollmentId])
}

// ── Sertifikater ────────────────────────────────────────

model Certificate {
  id               String           @id @default(uuid())
  tenantId         String
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course           Course           @relation(fields: [courseId], references: [id])
  enrollmentId     String?
  enrollment       CourseEnrollment? @relation(fields: [enrollmentId], references: [id])
  title            String           // Sertifikattittel
  description      String?          @db.Text
  issuedAt         DateTime         @default(now())
  expiresAt        DateTime?
  certificateNumber String?         @unique
  templateData     Json?            // Ekstra data for sertifikatmal
  
  createdAt        DateTime         @default(now())
  
  @@index([tenantId, userId])
  @@index([userId])
  @@index([courseId])
}

// ── Varsler / Notifikasjoner ────────────────────────────

enum NotificationType {
  COURSE_ASSIGNED
  COURSE_COMPLETED
  CERTIFICATE_ISSUED
  DEADLINE_REMINDER
  ONBOARDING_ASSIGNED
  RECERTIFICATION_DUE
  ESCALATION
  GENERAL
  SYSTEM
}

model Notification {
  id          String           @id @default(uuid())
  tenantId    String
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType @default(GENERAL)
  title       String
  message     String           @db.Text
  isRead      Boolean          @default(false)
  entityType  String?          // "course", "certificate", "enrollment", etc.
  entityId    String?          // Referanse til relevant entitet
  
  createdAt   DateTime         @default(now())
  
  @@index([tenantId, userId])
  @@index([userId, isRead])
}

// ══════════════════════════════════════════════════════════════
// SESJONER & ARRANGEMENTER (instruktørledet opplæring)
// ══════════════════════════════════════════════════════════════

enum SessionFormat {
  IN_PERSON   // Fysisk oppmøte
  ONLINE      // Nettbasert (lenke)
  HYBRID      // Begge deler
}

enum SessionStatus {
  DRAFT       // Kladd – ikke synlig for deltakere
  SCHEDULED   // Planlagt og publisert
  CANCELLED   // Avlyst
  COMPLETED   // Gjennomført
}

enum SessionEnrollmentStatus {
  REGISTERED  // Påmeldt
  WAITLISTED  // På venteliste
  CANCELLED   // Avmeldt
  ATTENDED    // Møtte opp
  NO_SHOW     // Møtte ikke
}

model TrainingSession {
  id               String        @id @default(uuid())
  tenantId         String
  title            String
  description      String?       @db.Text
  format           SessionFormat @default(IN_PERSON)
  status           SessionStatus @default(SCHEDULED)
  location         String?       // Fysisk sted (for IN_PERSON/HYBRID)
  meetingUrl       String?       // Online lenke (for ONLINE/HYBRID)
  startsAt         DateTime
  endsAt           DateTime
  capacity         Int?          // null = ubegrenset
  instructorUserId String?
  instructor       User?         @relation("SessionInstructor", fields: [instructorUserId], references: [id])
  courseId         String?       // Valgfri kobling til et kurs
  course           Course?       @relation(fields: [courseId], references: [id])

  enrollments      SessionEnrollment[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId, startsAt])
  @@index([tenantId, status])
}

model SessionEnrollment {
  id           String                  @id @default(uuid())
  tenantId     String
  sessionId    String
  session      TrainingSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User                    @relation("SessionAttendee", fields: [userId], references: [id], onDelete: Cascade)
  status       SessionEnrollmentStatus @default(REGISTERED)
  registeredAt DateTime                @default(now())
  attendedAt   DateTime?

  @@unique([sessionId, userId])
  @@index([tenantId, sessionId])
  @@index([tenantId, userId])
}

// ══════════════════════════════════════════════════════════════
// INNHOLD / MEDIA-BIBLIOTEK
// ══════════════════════════════════════════════════════════════

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

model MediaAsset {
  id               String    @id @default(uuid())
  tenantId         String
  url              String    @db.Text  // URL eller data-URI
  filename         String
  mimeType         String?
  sizeBytes        Int?
  kind             MediaKind @default(OTHER)
  uploadedByUserId String?
  createdAt        DateTime  @default(now())

  @@index([tenantId, kind])
  @@index([tenantId, createdAt])
}

// ══════════════════════════════════════════════════════════════
// INTEGRASJONER (SSO, SCIM, Webhooks, LTI)
// ══════════════════════════════════════════════════════════════

enum SsoProtocol {
  SAML
}

model SsoConnection {
  id               String      @id @default(uuid())
  tenantId         String      @unique // Én SSO-konfig per tenant (MVP)
  protocol         SsoProtocol @default(SAML)
  enabled          Boolean     @default(false)
  idpEntityId      String?     // IdP Entity ID / Issuer
  idpSsoUrl        String?     // IdP Single Sign-On URL
  idpCertificate   String?     @db.Text // IdP X.509-sertifikat (PEM)
  spEntityId       String?     // Vår SP Entity ID
  attributeMapping Json?       // {email: "...", firstName: "...", ...}

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model ScimToken {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  tokenHash   String    @unique // KUN hash lagres, aldri klartekst
  tokenPrefix String    // Første tegn for visning, f.eks. "scim_ab12…"
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

model Webhook {
  id          String   @id @default(uuid())
  tenantId    String
  url         String
  secret      String   // For HMAC-signering av payloads
  events      String[] // ["user.created", "course.completed", ...]
  enabled     Boolean  @default(true)

  deliveries  WebhookDelivery[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  tenantId    String
  webhookId   String
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event       String
  payload     Json
  statusCode  Int?
  success     Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())

  @@index([tenantId, webhookId])
  @@index([tenantId, createdAt])
}

model LtiPlatform {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  issuer      String   // Platform issuer (iss)
  clientId    String
  authUrl     String?  // OIDC auth endpoint
  jwksUrl     String?  // Public JWKS endpoint
  enabled     Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════════
// AUDIT-LOGGING (sikkerhetshendelser)
// ══════════════════════════════════════════════════════════════

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String?  // Hvem utførte handlingen
  actorEmail  String?  // Denormalisert for visning selv om bruker slettes
  action      String   // "user.role_changed", "sso.enabled", "session.created", ...
  targetType  String?  // "user", "session", "webhook", ...
  targetId    String?
  metadata    Json?    // Ekstra kontekst
  ip          String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

// ══════════════════════════════════════════════════════════════
// ONBOARDING-PROGRAMMER (tidsfaset auto-tildeling)
// ══════════════════════════════════════════════════════════════

model OnboardingProgram {
  id                 String   @id @default(uuid())
  tenantId           String
  name               String
  description        String?  @db.Text
  isActive           Boolean  @default(true)
  autoAssignOnCreate Boolean  @default(false) // Tildel automatisk til nye brukere
  autoAssignGroupId  String?  // Eller: tildel til medlemmer av en gruppe

  items              OnboardingProgramItem[]
  enrollments        OnboardingEnrollment[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
}

model OnboardingProgramItem {
  id          String            @id @default(uuid())
  tenantId    String
  programId   String
  program     OnboardingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseId    String?           // Kurs som tildeles (frist = tildelingsdato + offsetDays)
  title       String
  offsetDays  Int               @default(0) // Uke 1 = 0/7, uke 2 = 14, osv.
  sortOrder   Int               @default(0)

  @@index([tenantId, programId])
}

model OnboardingEnrollment {
  id          String            @id @default(uuid())
  tenantId    String
  programId   String
  program     OnboardingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime          @default(now())
  completedAt DateTime?

  @@unique([programId, userId])
  @@index([tenantId, userId])
}

// ══════════════════════════════════════════════════════════════
// FERDIGHETER & KOMPETANSE
// ══════════════════════════════════════════════════════════════

model Skill {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  description   String?  @db.Text
  category      String?
  parentSkillId String?  // Underferdighet av en annen ferdighet
  parentSkill   Skill?   @relation("SkillTree", fields: [parentSkillId], references: [id])
  childSkills   Skill[]  @relation("SkillTree")
  maxLevel      Int      @default(5) // Skala 1..maxLevel
  sortOrder     Int      @default(0)

  courses       CourseSkill[]
  userSkills    UserSkill[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, parentSkillId])
}

model CourseSkill {
  id        String  @id @default(uuid())
  tenantId  String
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     Int     @default(1) // Nivået kurset gir i ferdigheten

  createdAt DateTime @default(now())

  @@unique([courseId, skillId])
  @@index([tenantId, skillId])
}

model UserSkill {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level      Int      @default(1)
  source     String   @default("manual") // "manual" | "course" | "assessment"
  acquiredAt DateTime @default(now())

  @@unique([userId, skillId])
  @@index([tenantId, skillId])
}

// ══════════════════════════════════════════════════════════════
// SCORM (import + runtime)
// ══════════════════════════════════════════════════════════════

model ScormPackage {
  id           String   @id @default(uuid())
  tenantId     String
  title        String
  scormVersion String   @default("1.2") // "1.2" | "2004"
  entryPath    String   // Launch-fil relativt til pakkeroten (fra imsmanifest)
  packagePath  String   // Offentlig rot for utpakkede filer, f.eks. "/uploads/scorm/<id>"
  courseId     String?  // Valgfri kobling til et kurs
  manifestJson Json?    // Rådata fra imsmanifest.xml (organisasjoner, ressurser)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════════
// CUSTOM DOMENER (whitelabel)
// ══════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════
// RATE LIMITING (fixed-window teller)
// ══════════════════════════════════════════════════════════════

model RateLimit {
  id          String   @id @default(uuid())
  key         String   @unique // f.eks. "login:<email>" | "scim:<tenantId>" | "upload:<userId>"
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TenantDomain {
  id                String    @id @default(uuid())
  tenantId          String
  domain            String    @unique
  verificationToken String
  status            String    @default("pending") // pending | verified | failed
  verifiedAt        DateTime?
  isPrimary         Boolean   @default(false)
  lastCheckedAt     DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
}

model ScormAttempt {
  id             String    @id @default(uuid())
  tenantId       String
  scormPackageId String
  userId         String
  cmiJson        Json?     // Hele CMI-datamodellen (key/value)
  lessonStatus   String?   // completed | incomplete | passed | failed | browsed | not attempted
  scoreRaw       Float?
  suspendData    String?   @db.Text
  totalTime      String?   // SCORM tidsformat
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([scormPackageId, userId])
  @@index([tenantId, userId])
}
